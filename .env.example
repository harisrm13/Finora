# ==============================================================================
# FINORA — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Cloud PostgreSQL Database Configuration
# Salin nilai ini dari dashboard Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Authentication Secret
JWT_SECRET=finora-super-secret-jwt-key-2026-production-secure

# App Environment
NODE_ENV=development
